{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mustafa-content-os.local/schemas/claim.schema.json",
  "title": "Claim Contract",
  "description": "Definition for a future evidence-backed claim record. This phase does not implement a registry or validator.",
  "type": "object",
  "required": ["schema_version", "claim_id", "profile_id", "text", "status"],
  "properties": {
    "schema_version": { "type": "string" },
    "claim_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "text": { "type": "string" },
    "subject": { "type": "string" },
    "value": {},
    "unit": { "type": "string" },
    "scope": { "type": "string" },
    "period": { "type": "string" },
    "source_ref": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["draft", "self-reported", "verified", "expired", "rejected", "TODO_VERIFY"] },
    "allowed_usage": { "type": "array", "items": { "type": "string" } },
    "expires_at": { "type": "string", "format": "date" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
